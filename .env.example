# Copy this file to .env and replace every CHANGE_ME value before deployment.

# Public DNS name handled by the Traefik instance (hostname only, no scheme).
APP_HOSTNAME=rr.example.com

# MongoDB authentication. Use URL-safe values because these are also embedded
# in MONGO_URI; `openssl rand -hex 32` is a suitable password generator.
MONGO_ROOT_USERNAME=reasonreport
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGODB_PASSWORD
MONGO_DATABASE=flaskdb

# Generate each application secret independently with `openssl rand -hex 32`.
SECRET_KEY=CHANGE_ME_FLASK_SECRET
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET
JWT_COOKIE_SECURE=true

# Account/slug used to resolve the site's root page.
ADMIN_USERNAME=admin
INDEX_PAGE_NAME=mainpage

# MCP endpoint settings. Keep the /mcp suffix in the public URL.
MCP_PUBLIC_URL=https://rr.example.com/mcp
MCP_ISSUER_URL=
MCP_TOKEN_PEPPER=CHANGE_ME_MCP_TOKEN_PEPPER
